# LECHONK_PRICE_INPUT=0.68
# LECHONK_PRICE_OUTPUT=2.09

# The demo (docs/demo.md): a fine-grained token for the demo repo, and the Slack app's two tokens
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
